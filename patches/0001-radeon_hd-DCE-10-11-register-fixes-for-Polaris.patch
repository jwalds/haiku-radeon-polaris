From d6a5fbf268b770922a5086eb9a79d88a090c3bde Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonathan=20Waldsj=C3=B6?= <jonathan.waldsjo@gmail.com>
Date: Tue, 29 Sep 2026 19:16:50 +0000
Subject: [PATCH 01/11] radeon_hd: DCE 10/11 register fixes for Polaris

* Fix the chip name table order (Polaris 10/11 names were swapped).
* Read the VRAM size from CONFIG_MEMSIZE (0x5428) on Tahiti..Polaris,
  as Linux does; 0x03de is unaligned and kept only for Vega+.
* Use the DCE 10/11 per-CRTC register stride (0x800) and the moved
  LB_DESKTOP_HEIGHT register.
* LUT RW_MODE/WRITE_EN_MASK/RW_INDEX are per-CRTC.
* Skip PRESCALE_OVL_CONTROL on DCE 11 (register removed).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NqrEBcidivS5BSWVfbLqvu
---
 .../private/graphics/radeon_hd/radeon_hd.h    |  4 +-
 headers/private/graphics/radeon_hd/vol_reg.h  | 10 +++++
 src/add-ons/accelerants/radeon_hd/display.cpp | 42 ++++++++++++++++---
 .../drivers/graphics/radeon_hd/radeon_hd.cpp  |  9 +++-
 4 files changed, 55 insertions(+), 10 deletions(-)

diff --git a/headers/private/graphics/radeon_hd/radeon_hd.h b/headers/private/graphics/radeon_hd/radeon_hd.h
index 4da051a82f..a53907158d 100644
--- a/headers/private/graphics/radeon_hd/radeon_hd.h
+++ b/headers/private/graphics/radeon_hd/radeon_hd.h
@@ -183,8 +183,8 @@ static const char radeon_chip_name[][MAX_NAME_LENGTH] = {
 	"Fiji",
 	"Carrizo",
 	"Stoney Ridge",
-	"Polaris 11",
 	"Polaris 10",
+	"Polaris 11",
 	"Polaris 12",
 	"Vega Mobile",
 	"Vega 10",
@@ -291,7 +291,7 @@ struct radeon_free_graphics_memory {
 #define R6XX_CONFIG_APER_SIZE			0x5430	// r600>
 #define OLD_CONFIG_APER_SIZE			0x0108	// <r600
 #define CONFIG_MEMSIZE					0x5428	// r600>
-#define CONFIG_MEMSIZE_TAHITI			0x03de	// tahiti>
+#define CONFIG_MEMSIZE_TAHITI			0x03de	// TODO: Vega+? unverified
 
 
 #endif	/* RADEON_HD_H */
diff --git a/headers/private/graphics/radeon_hd/vol_reg.h b/headers/private/graphics/radeon_hd/vol_reg.h
index d1d1221ad8..e694284810 100644
--- a/headers/private/graphics/radeon_hd/vol_reg.h
+++ b/headers/private/graphics/radeon_hd/vol_reg.h
@@ -27,6 +27,16 @@
 #ifndef DCE_10_0_D_H
 #define DCE_10_0_D_H
 
+// DCE 10.x, 11.x CRTC register offsets (byte addresses)
+#define VOL_CRTC0_REGISTER_OFFSET		(0x6e70 - 0x6e70)
+#define VOL_CRTC1_REGISTER_OFFSET		(0x7670 - 0x6e70)
+#define VOL_CRTC2_REGISTER_OFFSET		(0x7e70 - 0x6e70)
+#define VOL_CRTC3_REGISTER_OFFSET		(0x10670 - 0x6e70)
+#define VOL_CRTC4_REGISTER_OFFSET		(0x10e70 - 0x6e70)
+#define VOL_CRTC5_REGISTER_OFFSET		(0x11670 - 0x6e70)
+
+#define VOL_LB_DESKTOP_HEIGHT			0x6b0c
+
 #define VOL_mmDC_GPIO_HPD_A                                                         0x488d
 
 #endif /* DCE_10_0_D_H */
diff --git a/src/add-ons/accelerants/radeon_hd/display.cpp b/src/add-ons/accelerants/radeon_hd/display.cpp
index 3d83804aab..f3e7f1680a 100644
--- a/src/add-ons/accelerants/radeon_hd/display.cpp
+++ b/src/add-ons/accelerants/radeon_hd/display.cpp
@@ -80,6 +80,30 @@ init_registers(register_info* regs, uint8 crtcID)
 				return B_ERROR;
 		}
 
+		if (info.dceMajor == 10 || info.dceMajor == 11) {
+			// DCE 10.x, 11.x have a smaller CRTC register stride
+			switch (crtcID) {
+				case 0:
+					offset = VOL_CRTC0_REGISTER_OFFSET;
+					break;
+				case 1:
+					offset = VOL_CRTC1_REGISTER_OFFSET;
+					break;
+				case 2:
+					offset = VOL_CRTC2_REGISTER_OFFSET;
+					break;
+				case 3:
+					offset = VOL_CRTC3_REGISTER_OFFSET;
+					break;
+				case 4:
+					offset = VOL_CRTC4_REGISTER_OFFSET;
+					break;
+				case 5:
+					offset = VOL_CRTC5_REGISTER_OFFSET;
+					break;
+			}
+		}
+
 		regs->crtcOffset = offset;
 
 		regs->grphEnable = EVERGREEN_GRPH_ENABLE + offset;
@@ -104,7 +128,10 @@ init_registers(register_info* regs, uint8 crtcID)
 		regs->grphYStart = EVERGREEN_GRPH_Y_START + offset;
 		regs->grphXEnd = EVERGREEN_GRPH_X_END + offset;
 		regs->grphYEnd = EVERGREEN_GRPH_Y_END + offset;
-		regs->modeDesktopHeight = EVERGREEN_DESKTOP_HEIGHT + offset;
+		if (info.dceMajor == 10 || info.dceMajor == 11)
+			regs->modeDesktopHeight = VOL_LB_DESKTOP_HEIGHT + offset;
+		else
+			regs->modeDesktopHeight = EVERGREEN_DESKTOP_HEIGHT + offset;
 		regs->modeDataFormat = EVERGREEN_DATA_FORMAT + offset;
 		regs->viewportStart = EVERGREEN_VIEWPORT_START + offset;
 		regs->viewportSize = EVERGREEN_VIEWPORT_SIZE + offset;
@@ -608,8 +635,11 @@ display_dce45_crtc_load_lut(uint8 crtcID)
 				| NI_INPUT_CSC_OVL_MODE(NI_INPUT_CSC_BYPASS));
 		Write32(OUT, NI_PRESCALE_GRPH_CONTROL + regs->crtcOffset,
 			NI_GRPH_PRESCALE_BYPASS);
-		Write32(OUT, NI_PRESCALE_OVL_CONTROL + regs->crtcOffset,
-			NI_OVL_PRESCALE_BYPASS);
+		if (info.dceMajor < 11) {
+			// No overlay prescale on DCE 11.x
+			Write32(OUT, NI_PRESCALE_OVL_CONTROL + regs->crtcOffset,
+				NI_OVL_PRESCALE_BYPASS);
+		}
 		Write32(OUT, NI_INPUT_GAMMA_CONTROL + regs->crtcOffset,
 			NI_GRPH_INPUT_GAMMA_MODE(NI_INPUT_GAMMA_USE_LUT) |
 			NI_OVL_INPUT_GAMMA_MODE(NI_INPUT_GAMMA_USE_LUT));
@@ -625,10 +655,10 @@ display_dce45_crtc_load_lut(uint8 crtcID)
 	Write32(OUT, EVERGREEN_DC_LUT_WHITE_OFFSET_GREEN + regs->crtcOffset, 0xffff);
 	Write32(OUT, EVERGREEN_DC_LUT_WHITE_OFFSET_RED + regs->crtcOffset, 0xffff);
 
-	Write32(OUT, EVERGREEN_DC_LUT_RW_MODE, 0);
-	Write32(OUT, EVERGREEN_DC_LUT_WRITE_EN_MASK, 0x00000007);
+	Write32(OUT, EVERGREEN_DC_LUT_RW_MODE + regs->crtcOffset, 0);
+	Write32(OUT, EVERGREEN_DC_LUT_WRITE_EN_MASK + regs->crtcOffset, 0x00000007);
 
-	Write32(OUT, EVERGREEN_DC_LUT_RW_INDEX, 0);
+	Write32(OUT, EVERGREEN_DC_LUT_RW_INDEX + regs->crtcOffset, 0);
 	for (int i = 0; i < 256; i++) {
 		Write32(OUT, EVERGREEN_DC_LUT_30_COLOR + regs->crtcOffset,
 			(r[i] << 20) | (g[i] << 10) | (b[i] << 0));
diff --git a/src/add-ons/kernel/drivers/graphics/radeon_hd/radeon_hd.cpp b/src/add-ons/kernel/drivers/graphics/radeon_hd/radeon_hd.cpp
index f99811a1e4..9cdc2fc283 100644
--- a/src/add-ons/kernel/drivers/graphics/radeon_hd/radeon_hd.cpp
+++ b/src/add-ons/kernel/drivers/graphics/radeon_hd/radeon_hd.cpp
@@ -707,10 +707,15 @@ radeon_hd_init(radeon_info &info)
 	mmioMapper.Detach();
 
 	// *** Populate frame buffer information
-	if (info.chipsetID >= RADEON_TAHITI) {
-		// Tahiti+ has memory stored in MB
+	if (info.chipsetID >= RADEON_VEGAM) {
+		// TODO: Vega+ (SOC15) register location unverified
 		info.shared_info->graphics_memory_size
 			= read32(info.registers + CONFIG_MEMSIZE_TAHITI) * 1024;
+	} else if (info.chipsetID >= RADEON_TAHITI) {
+		// Tahiti through Polaris: CONFIG_MEMSIZE (0x5428) holds MB
+		// (Linux: si.c, gmc_v7_0.c, gmc_v8_0.c)
+		info.shared_info->graphics_memory_size
+			= read32(info.registers + CONFIG_MEMSIZE) * 1024;
 	} else if (info.chipsetID >= RADEON_CEDAR) {
 		switch (info.chipsetID) {
 			default:
-- 
