diff --git a/src/add-ons/accelerants/radeon_hd/cursor.cpp b/src/add-ons/accelerants/radeon_hd/cursor.cpp
new file mode 100644
index 0000000000..be2f0dd74e
--- /dev/null
+++ b/src/add-ons/accelerants/radeon_hd/cursor.cpp
@@ -0,0 +1,274 @@
+/*
+ * Copyright 2026, Haiku, Inc. All Rights Reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "cursor.h"
+
+#include <string.h>
+
+#include "accelerant.h"
+#include "accelerant_protos.h"
+#include "display.h"
+
+
+#define TRACE_CURSOR
+#ifdef TRACE_CURSOR
+extern "C" void _sPrintf(const char* format, ...);
+#	define TRACE(x...) _sPrintf("radeon_hd: " x)
+#else
+#	define TRACE(x...) ;
+#endif
+
+#define ERROR(x...) _sPrintf("radeon_hd: " x)
+
+
+// The cursor image always uses a fixed size surface; smaller cursors are
+// padded with transparent pixels. The row pitch of the cursor surface is the
+// maximum cursor width of the hardware: 64 pixels up to DCE 6, 128 pixels
+// from DCE 8 on.
+static const uint32 kCursorSize = 64;
+static const uint32 kCursorImageSize = 128 * kCursorSize * 4;
+
+
+static uint32
+cursor_pitch()
+{
+	if (gInfo->shared_info->dceMajor >= 8)
+		return 128;
+	return 64;
+}
+
+
+/*! The cursor image lives in the last page aligned block of the mapped
+	frame buffer, out of the way of the visible screen.
+*/
+static uint64
+cursor_offset()
+{
+	uint64 frameBufferSize
+		= (uint64)gInfo->shared_info->frame_buffer_size * 1024;
+	return (frameBufferSize - kCursorImageSize) & ~(uint64)(B_PAGE_SIZE - 1);
+}
+
+
+bool
+cursor_supported()
+{
+	// Evergreen style cursor registers
+	return gInfo != NULL && gInfo->shared_info->dceMajor >= 4;
+}
+
+
+static uint32*
+cursor_image()
+{
+	return (uint32*)(gInfo->shared_info->frame_buffer + cursor_offset());
+}
+
+
+/*! Returns false once the accelerant has been uninitialized; app_server's
+	cursor thread can still call the hooks while it shuts down.
+*/
+static bool
+cursor_available(uint8 crtcID)
+{
+	return gInfo != NULL && gDisplay[crtcID] != NULL
+		&& gDisplay[crtcID]->regs != NULL;
+}
+
+
+static void
+cursor_lock(uint8 crtcID, bool lock)
+{
+	register_info* regs = gDisplay[crtcID]->regs;
+	uint32 update = Read32(OUT, EVERGREEN_CUR_UPDATE + regs->crtcOffset);
+	if (lock)
+		update |= EVERGREEN_CURSOR_UPDATE_LOCK;
+	else
+		update &= ~EVERGREEN_CURSOR_UPDATE_LOCK;
+	Write32(OUT, EVERGREEN_CUR_UPDATE + regs->crtcOffset, update);
+}
+
+
+static void
+cursor_set_position(uint8 crtcID)
+{
+	register_info* regs = gDisplay[crtcID]->regs;
+
+	int32 x = (int32)gInfo->cursorX - gInfo->cursorHotX;
+	int32 y = (int32)gInfo->cursorY - gInfo->cursorHotY;
+	uint32 xOrigin = 0;
+	uint32 yOrigin = 0;
+
+	// The position can't be negative, move the hot spot instead
+	if (x < 0) {
+		xOrigin = min_c(-x, (int32)kCursorSize - 1);
+		x = 0;
+	}
+	if (y < 0) {
+		yOrigin = min_c(-y, (int32)kCursorSize - 1);
+		y = 0;
+	}
+
+	Write32(OUT, EVERGREEN_CUR_POSITION + regs->crtcOffset, (x << 16) | y);
+	Write32(OUT, EVERGREEN_CUR_HOT_SPOT + regs->crtcOffset,
+		(xOrigin << 16) | yOrigin);
+	Write32(OUT, EVERGREEN_CUR_SIZE + regs->crtcOffset,
+		((kCursorSize - 1) << 16) | (kCursorSize - 1));
+}
+
+
+static void
+cursor_enable(uint8 crtcID, bool enable)
+{
+	register_info* regs = gDisplay[crtcID]->regs;
+
+	uint32 control = Read32(OUT, EVERGREEN_CUR_CONTROL + regs->crtcOffset);
+	control &= ~(EVERGREEN_CURSOR_EN | EVERGREEN_CURSOR_MODE(0x3));
+
+	if (enable) {
+		uint64 address = gInfo->fb.vramStart + cursor_offset();
+		Write32(OUT, EVERGREEN_CUR_SURFACE_ADDRESS_HIGH + regs->crtcOffset,
+			(address >> 32) & 0xff);
+		Write32(OUT, EVERGREEN_CUR_SURFACE_ADDRESS + regs->crtcOffset,
+			address & EVERGREEN_CUR_SURFACE_ADDRESS_MASK);
+
+		control |= EVERGREEN_CURSOR_EN
+			| EVERGREEN_CURSOR_MODE(EVERGREEN_CURSOR_24_8_PRE_MULT);
+	}
+
+	Write32(OUT, EVERGREEN_CUR_CONTROL + regs->crtcOffset, control);
+}
+
+
+//	#pragma mark - accelerant hooks
+
+
+status_t
+radeon_set_cursor_shape(uint16 width, uint16 height, uint16 hotX, uint16 hotY,
+	const uint8* andMask, const uint8* xorMask)
+{
+	TRACE("%s: %" B_PRIu16 "x%" B_PRIu16 "\n", __func__, width, height);
+
+	if (width > kCursorSize || height > kCursorSize)
+		return B_BAD_VALUE;
+	if (!cursor_available(0))
+		return B_NO_INIT;
+
+	uint32* image = cursor_image();
+	uint32 pitch = cursor_pitch();
+	memset(image, 0, kCursorImageSize);
+
+	uint32 bytesPerRow = (width + 7) / 8;
+	for (uint32 y = 0; y < height; y++) {
+		for (uint32 x = 0; x < width; x++) {
+			uint32 byte = y * bytesPerRow + x / 8;
+			uint8 bit = 0x80 >> (x % 8);
+			bool transparent = (andMask[byte] & bit) != 0;
+			bool white = (xorMask[byte] & bit) != 0;
+
+			uint32 pixel;
+			if (transparent && !white)
+				pixel = 0x00000000;
+			else if (white && !transparent)
+				pixel = 0xffffffff;
+			else {
+				// black, or "invert screen" which the hardware can't do
+				pixel = 0xff000000;
+			}
+			image[y * pitch + x] = pixel;
+		}
+	}
+
+	gInfo->cursorHotX = hotX;
+	gInfo->cursorHotY = hotY;
+
+	uint8 crtcID = 0;
+	cursor_lock(crtcID, true);
+	cursor_set_position(crtcID);
+	cursor_lock(crtcID, false);
+
+	return B_OK;
+}
+
+
+status_t
+radeon_set_cursor_bitmap(uint16 width, uint16 height, uint16 hotX,
+	uint16 hotY, color_space colorSpace, uint16 bytesPerRow,
+	const uint8* bitmapData)
+{
+	TRACE("%s: %" B_PRIu16 "x%" B_PRIu16 "\n", __func__, width, height);
+
+	if (width > kCursorSize || height > kCursorSize)
+		return B_BAD_VALUE;
+	if (colorSpace != B_RGBA32)
+		return B_BAD_VALUE;
+	if (!cursor_available(0))
+		return B_NO_INIT;
+
+	uint32* image = cursor_image();
+	uint32 pitch = cursor_pitch();
+	memset(image, 0, kCursorImageSize);
+
+	// The hardware wants premultiplied alpha
+	for (uint32 y = 0; y < height; y++) {
+		const uint8* source = bitmapData + y * bytesPerRow;
+		for (uint32 x = 0; x < width; x++) {
+			uint32 blue = source[x * 4 + 0];
+			uint32 green = source[x * 4 + 1];
+			uint32 red = source[x * 4 + 2];
+			uint32 alpha = source[x * 4 + 3];
+
+			blue = blue * alpha / 255;
+			green = green * alpha / 255;
+			red = red * alpha / 255;
+
+			image[y * pitch + x]
+				= (alpha << 24) | (red << 16) | (green << 8) | blue;
+		}
+	}
+
+	gInfo->cursorHotX = hotX;
+	gInfo->cursorHotY = hotY;
+
+	uint8 crtcID = 0;
+	cursor_lock(crtcID, true);
+	cursor_set_position(crtcID);
+	cursor_lock(crtcID, false);
+
+	return B_OK;
+}
+
+
+void
+radeon_move_cursor(uint16 x, uint16 y)
+{
+	if (!cursor_available(0))
+		return;
+
+	gInfo->cursorX = x;
+	gInfo->cursorY = y;
+
+	uint8 crtcID = 0;
+	cursor_lock(crtcID, true);
+	cursor_set_position(crtcID);
+	cursor_lock(crtcID, false);
+}
+
+
+void
+radeon_show_cursor(bool isVisible)
+{
+	TRACE("%s: %s\n", __func__, isVisible ? "true" : "false");
+
+	uint8 crtcID = 0;
+	if (!cursor_available(crtcID))
+		return;
+
+	cursor_lock(crtcID, true);
+	cursor_enable(crtcID, isVisible);
+	cursor_set_position(crtcID);
+	cursor_lock(crtcID, false);
+}
