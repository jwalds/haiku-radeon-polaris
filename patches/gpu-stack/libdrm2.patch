diff --git a/libdrm.cpp b/libdrm.cpp
index e5d44cf..b45bf50 100644
--- a/libdrm.cpp
+++ b/libdrm.cpp
@@ -14,6 +14,8 @@ extern "C" {
 #include <SupportDefs.h>
 #include <OS.h>
 #include <AccelerantRoster.h>
+#include <AccelerantDrm.h>
+#include <Referenceable.h>
 
 #include "ScopeExit.h"
 
@@ -53,7 +55,110 @@ drm_public void drmMsg(const char *format, ...)
 
 // #pragma mark - ioctl interface
 
+// Generic DRM ioctls (Mesa's vk_drm_syncobj calls drmSyncobj*() directly)
+// go to the accelerant serving the fd, so that they reach the same server
+// state as the libdrm_amdgpu calls. Other fds use the stub.
+static int
+AccelerantDrmIoctl(accelerant_drm *drm, unsigned long request, void *arg)
+{
+	accelerant_drm_vtable *vt = drm->vt;
+	switch (request) {
+		case DRM_IOCTL_GEM_CLOSE: {
+			auto args = (struct drm_gem_close*)arg;
+			return vt->DrmCloseBufferHandle(drm, args->handle);
+		}
+		case DRM_IOCTL_PRIME_HANDLE_TO_FD: {
+			auto args = (struct drm_prime_handle*)arg;
+			return vt->DrmPrimeHandleToFD(drm, args->handle, args->flags, &args->fd);
+		}
+		case DRM_IOCTL_PRIME_FD_TO_HANDLE: {
+			auto args = (struct drm_prime_handle*)arg;
+			return vt->DrmPrimeFDToHandle(drm, args->fd, &args->handle);
+		}
+		case DRM_IOCTL_SYNCOBJ_CREATE: {
+			auto args = (struct drm_syncobj_create*)arg;
+			return vt->DrmSyncobjCreate(drm, args->flags, &args->handle);
+		}
+		case DRM_IOCTL_SYNCOBJ_DESTROY: {
+			auto args = (struct drm_syncobj_destroy*)arg;
+			return vt->DrmSyncobjDestroy(drm, args->handle);
+		}
+		case DRM_IOCTL_SYNCOBJ_HANDLE_TO_FD: {
+			auto args = (struct drm_syncobj_handle*)arg;
+			if ((args->flags & DRM_SYNCOBJ_HANDLE_TO_FD_FLAGS_EXPORT_SYNC_FILE) != 0)
+				return vt->DrmSyncobjExportSyncFile(drm, args->handle, &args->fd);
+			return vt->DrmSyncobjHandleToFD(drm, args->handle, &args->fd);
+		}
+		case DRM_IOCTL_SYNCOBJ_FD_TO_HANDLE: {
+			auto args = (struct drm_syncobj_handle*)arg;
+			if ((args->flags & DRM_SYNCOBJ_FD_TO_HANDLE_FLAGS_IMPORT_SYNC_FILE) != 0)
+				return vt->DrmSyncobjImportSyncFile(drm, args->handle, args->fd);
+			return vt->DrmSyncobjFDToHandle(drm, args->fd, &args->handle);
+		}
+		case DRM_IOCTL_SYNCOBJ_WAIT: {
+			auto args = (struct drm_syncobj_wait*)arg;
+			return vt->DrmSyncobjWait(drm, (uint32_t*)(addr_t)args->handles,
+				args->count_handles, args->timeout_nsec, args->flags,
+				&args->first_signaled);
+		}
+		case DRM_IOCTL_SYNCOBJ_TIMELINE_WAIT: {
+			auto args = (struct drm_syncobj_timeline_wait*)arg;
+			return vt->DrmSyncobjTimelineWait(drm,
+				(uint32_t*)(addr_t)args->handles, (uint64_t*)(addr_t)args->points,
+				args->count_handles, args->timeout_nsec, args->flags,
+				&args->first_signaled);
+		}
+		case DRM_IOCTL_SYNCOBJ_RESET: {
+			auto args = (struct drm_syncobj_array*)arg;
+			return vt->DrmSyncobjReset(drm, (const uint32_t*)(addr_t)args->handles,
+				args->count_handles);
+		}
+		case DRM_IOCTL_SYNCOBJ_SIGNAL: {
+			auto args = (struct drm_syncobj_array*)arg;
+			return vt->DrmSyncobjSignal(drm, (const uint32_t*)(addr_t)args->handles,
+				args->count_handles);
+		}
+		case DRM_IOCTL_SYNCOBJ_TIMELINE_SIGNAL: {
+			auto args = (struct drm_syncobj_timeline_array*)arg;
+			return vt->DrmSyncobjTimelineSignal(drm,
+				(const uint32_t*)(addr_t)args->handles,
+				(uint64_t*)(addr_t)args->points, args->count_handles);
+		}
+		case DRM_IOCTL_SYNCOBJ_QUERY: {
+			auto args = (struct drm_syncobj_timeline_array*)arg;
+			return vt->DrmSyncobjQuery(drm, (uint32_t*)(addr_t)args->handles,
+				(uint64_t*)(addr_t)args->points, args->count_handles, args->flags);
+		}
+		case DRM_IOCTL_SYNCOBJ_TRANSFER: {
+			auto args = (struct drm_syncobj_transfer*)arg;
+			return vt->DrmSyncobjTransfer(drm, args->dst_handle, args->dst_point,
+				args->src_handle, args->src_point, args->flags);
+		}
+	}
+	return B_DEV_INVALID_IOCTL;
+}
+
+
 drm_public int drmIoctl(int fd, unsigned long request, void *arg)
 {
+	Accelerant *acc = NULL;
+	if (AccelerantRoster::Instance().FromFd(acc, fd) >= B_OK && acc != NULL) {
+		BReference<Accelerant> accRef(acc, true);
+		accelerant_base *base = (accelerant_base*)static_cast<AccelerantBase*>(acc);
+		accelerant_drm *drm = (accelerant_drm*)base->vt->QueryInterface(base,
+			B_ACCELERANT_IFACE_DRM, 0);
+		if (drm != NULL) {
+			int res = AccelerantDrmIoctl(drm, request, arg);
+			if (res != B_DEV_INVALID_IOCTL) {
+				if (doTrace)
+					fprintf(stderr, "drmIoctl(%d, %#lx): %d\n", fd, request, res);
+				if (res != 0) {
+					errno = res;
+					return -1;
+				}
+				return 0;
+			}
+		}
+	}
 	return drmIoctlStub(fd, request, arg);
 }
