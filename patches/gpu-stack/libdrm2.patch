+}
diff --git a/amdgpu/amdgpu_device_haiku.cpp b/amdgpu/amdgpu_device_haiku.cpp
index 4f23640..b8d0d04 100644
--- a/amdgpu/amdgpu_device_haiku.cpp
+++ b/amdgpu/amdgpu_device_haiku.cpp
@@ -19,5 +19,8 @@ drm_public int amdgpu_device_initialize(int fd,
 	BReference<Accelerant> accDeleter(acc, true);
 	accelerant_base *acc_base = (accelerant_base*)static_cast<AccelerantBase*>(acc);
 
-	return amdgpu_device_initialize_haiku(acc_base, major_version, minor_version, device_handle);
+	int r = amdgpu_device_initialize_haiku(acc_base, major_version, minor_version, device_handle);
