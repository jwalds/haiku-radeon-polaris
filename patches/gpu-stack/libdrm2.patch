diff --git a/libdrm_device.cpp b/libdrm_device.cpp
index 6397d60..d363444 100644
--- a/libdrm_device.cpp
+++ b/libdrm_device.cpp
@@ -2,7 +2,6 @@
 
 #include <xf86drm.h>
 #include "libdrm_macros.h"
-#include "util_math.h"
 #include <errno.h>
 #include <unistd.h>
 #include <stdio.h>
@@ -13,10 +12,18 @@
 #include <algorithm>
 
 #include <Entry.h>
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <Drivers.h>
+#include <graphic_driver.h>
 #include <Directory.h>
 
 #include "Poke.h"
 
+// <sys/param.h> defines a one argument ALIGN()
+#undef ALIGN
+#include "util_math.h"
+
 #define memclear(s) memset(&s, 0, sizeof(s))
 
 static const char sDevPath[] = "/dev/graphics/";
@@ -121,6 +128,15 @@ static int drmGetDeviceInt(drmDevicePtr *device, const char *name)
 	char path[MAXPATHLEN];
 	sprintf(path, "%s%s", sDevPath, name);
 
+	// only devices served by the RadeonGfx server; with radeon_hd the
+	// display device has its own accelerant next to the render device
+	int fd = open(path, O_RDWR);
+	if (fd < 0) return ENOENT;
+	char signature[B_FILE_NAME_LENGTH] = "";
+	ioctl(fd, B_GET_ACCELERANT_SIGNATURE, signature, sizeof(signature));
+	close(fd);
+	if (strcmp(signature, "radeon_gfx.accelerant") != 0) return ENOENT;
+
 	drmDevicePtr dev = drmDeviceAlloc(DRM_NODE_RENDER, path, sizeof(drmPciBusInfo), sizeof(drmPciDeviceInfo));
 	if (dev == NULL) return B_NO_MEMORY;
 
@@ -150,10 +166,12 @@ drm_public int drmGetDevices2(uint32_t flags, drmDevicePtr devices[], int max_de
 	for (deviceCnt = 0; deviceCnt < max_devices;) {
 		BEntry entry;
 		if (dir.GetNextEntry(&entry, true) < B_OK) break;
-		if (devices != NULL) {
-			drmGetDeviceInt(&devices[deviceCnt], entry.Name());
-			if (devices[deviceCnt] != NULL) deviceCnt++;
-		}
+		drmDevicePtr device = NULL;
+		drmGetDeviceInt(&device, entry.Name());
+		if (device == NULL) continue;
+		if (devices != NULL) devices[deviceCnt] = device;
+		else drmFreeDevice(&device);
+		deviceCnt++;
 	}
 	return deviceCnt;
 }
