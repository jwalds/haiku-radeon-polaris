index a0ff8f0..4e346a5 100644
--- a/amdgpu/amdgpu_bo.c
+++ b/amdgpu/amdgpu_bo.c
@@ -32,6 +32,9 @@
 #include <sys/ioctl.h>
 #include <sys/mman.h>
 #include <sys/time.h>
+#ifdef __HAIKU__
+#include <OS.h>
+#endif
 
 #include <inttypes.h>
 
@@ -336,7 +339,17 @@ drm_public int amdgpu_bo_cpu_unmap(amdgpu_bo_handle bo)
 		return 0;
 	}
 
+#ifdef __HAIKU__
+	/* every CPU map is its own clone of the server area (which can be the
+	 * whole CPU visible VRAM): delete that clone. A partial munmap() of a
+	 * device memory area panics the kernel (VMCache::Commit()). */
+	{
+		area_id area = area_for(bo->cpu_ptr);
+		r = (area >= 0 && delete_area(area) == B_OK) ? 0 : -EINVAL;
+	}
+#else
 	r = drm_munmap(bo->cpu_ptr, bo->alloc_size) == 0 ? 0 : -errno;
+#endif
 	bo->cpu_ptr = NULL;
 	pthread_mutex_unlock(&bo->cpu_access_mutex);
 	return r;
