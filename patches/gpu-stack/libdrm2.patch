--- a/amdgpu/amdgpu_device.c
+++ b/amdgpu/amdgpu_device.c
@@ -134,13 +134,13 @@ drm_public int amdgpu_device_initialize_haiku(struct accelerant_base *acc,
 
 	acc->vt->AcquireReference(acc);
 	dev->acc_base = acc;
-	dev->acc_drm = (accelerant_drm*)dev->acc_base->vt->QueryInterface(dev->acc_base, B_ACCELERANT_IFACE_DRM);
+	dev->acc_drm = (accelerant_drm*)dev->acc_base->vt->QueryInterface(dev->acc_base, B_ACCELERANT_IFACE_DRM, 0);
