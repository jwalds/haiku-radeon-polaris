 	if (!dev->acc_amdgpu) {
 		fprintf(stderr, "%s: Accelerant don't provide AMDGPU interface\n", __func__);
 		r = EBADF;
@@ -257,3 +257,8 @@ drm_public int amdgpu_query_sw_info(amdgpu_device_handle dev,
 	}
 	return EINVAL;
 }
+
+drm_public int amdgpu_device_get_fd(amdgpu_device_handle device_handle)
