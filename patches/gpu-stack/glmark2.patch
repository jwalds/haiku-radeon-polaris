diff --git a/src/gl-state-egl.cpp b/src/gl-state-egl.cpp
index 61d7f06..5c95623 100644
--- a/src/gl-state-egl.cpp
+++ b/src/gl-state-egl.cpp
@@ -649,7 +649,13 @@ GLStateEGL::gotValidDisplay()
 #endif
 #elif GLMARK2_USE_GL
     EGLenum apiType(EGL_OPENGL_API);
+#ifdef __HAIKU__
+    /* Haiku's libGL is its own OpenGL; with Mesa's EGL all entry points
