diff --git a/src/native-state-wayland.cpp b/src/native-state-wayland.cpp
index e1d1d41..424abba 100644
--- a/src/native-state-wayland.cpp
+++ b/src/native-state-wayland.cpp
@@ -23,7 +23,14 @@
 #include "native-state-wayland.h"
 #include "log.h"
 
+#ifdef __HAIKU__
+/* evdev codes, as Wayland sends them */
+#define BTN_LEFT 0x110
+#define KEY_ESC 1
+#define KEY_Q 16
+#else
 #include <linux/input.h>
+#endif
 #include <cstring>
 #include <csignal>
 #include <unistd.h>
@@ -126,6 +133,13 @@ NativeStateWayland::~NativeStateWayland()
             wl_registry_destroy(display_->registry);
         if (display_->display) {
             wl_display_flush(display_->display);
+#ifdef __HAIKU__
+            /* Haiku's in-process Wayland server quits the BWindow of a
+             * destroyed surface asynchronously; disconnecting unloads its
+             * code, which crashes a window thread that is still running */
+            wl_display_roundtrip(display_->display);
+            usleep(200000);
+#endif
             wl_display_disconnect(display_->display);
         }
         delete display_;
diff --git a/src/shared-library.cpp b/src/shared-library.cpp
