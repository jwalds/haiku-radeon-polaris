--- a/src/video/wayland/SDL_waylandvideo.c	2025-05-19 23:24:41.000000000 +0200
+++ b/src/video/wayland/SDL_waylandvideo.c	2026-10-08 17:00:33.108527616 +0200
@@ -160,6 +160,13 @@
     SDL_VideoData *data = (SDL_VideoData *)device->driverdata;
     if (data->display) {
         WAYLAND_wl_display_flush(data->display);
+#ifdef __HAIKU__
+        /* Haiku's in-process Wayland server closes the window of a destroyed
+           surface asynchronously; disconnecting meanwhile crashes the client
+           in wl_display_disconnect(). */
+        WAYLAND_wl_display_roundtrip(data->display);
+        SDL_Delay(200);
+#endif
         WAYLAND_wl_display_disconnect(data->display);
     }
     SDL_free(data);
