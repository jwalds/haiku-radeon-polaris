--- a/src/add-ons/accelerants/radeon_hd/display.cpp
+++ b/src/add-ons/accelerants/radeon_hd/display.cpp
@@ -80,6 +80,30 @@ init_registers(register_info* regs, uint8 crtcID)
 				return B_ERROR;
 		}
 
+		if (info.dceMajor == 10 || info.dceMajor == 11) {
+			// DCE 10.x, 11.x have a smaller CRTC register stride
+			switch (crtcID) {
+				case 0:
+					offset = VOL_CRTC0_REGISTER_OFFSET;
+					break;
+				case 1:
+					offset = VOL_CRTC1_REGISTER_OFFSET;
+					break;
+				case 2:
+					offset = VOL_CRTC2_REGISTER_OFFSET;
+					break;
+				case 3:
+					offset = VOL_CRTC3_REGISTER_OFFSET;
+					break;
+				case 4:
+					offset = VOL_CRTC4_REGISTER_OFFSET;
+					break;
+				case 5:
+					offset = VOL_CRTC5_REGISTER_OFFSET;
+					break;
+			}
+		}
+
 		regs->crtcOffset = offset;
 
 		regs->grphEnable = EVERGREEN_GRPH_ENABLE + offset;
@@ -104,7 +128,10 @@ init_registers(register_info* regs, uint8 crtcID)
 		regs->grphYStart = EVERGREEN_GRPH_Y_START + offset;
 		regs->grphXEnd = EVERGREEN_GRPH_X_END + offset;
 		regs->grphYEnd = EVERGREEN_GRPH_Y_END + offset;
-		regs->modeDesktopHeight = EVERGREEN_DESKTOP_HEIGHT + offset;
+		if (info.dceMajor == 10 || info.dceMajor == 11)
+			regs->modeDesktopHeight = VOL_LB_DESKTOP_HEIGHT + offset;
+		else
+			regs->modeDesktopHeight = EVERGREEN_DESKTOP_HEIGHT + offset;
 		regs->modeDataFormat = EVERGREEN_DATA_FORMAT + offset;
 		regs->viewportStart = EVERGREEN_VIEWPORT_START + offset;
 		regs->viewportSize = EVERGREEN_VIEWPORT_SIZE + offset;
@@ -608,8 +635,11 @@ display_dce45_crtc_load_lut(uint8 crtcID)
 				| NI_INPUT_CSC_OVL_MODE(NI_INPUT_CSC_BYPASS));
 		Write32(OUT, NI_PRESCALE_GRPH_CONTROL + regs->crtcOffset,
 			NI_GRPH_PRESCALE_BYPASS);
-		Write32(OUT, NI_PRESCALE_OVL_CONTROL + regs->crtcOffset,
-			NI_OVL_PRESCALE_BYPASS);
+		if (info.dceMajor < 11) {
+			// No overlay prescale on DCE 11.x
+			Write32(OUT, NI_PRESCALE_OVL_CONTROL + regs->crtcOffset,
+				NI_OVL_PRESCALE_BYPASS);
+		}
 		Write32(OUT, NI_INPUT_GAMMA_CONTROL + regs->crtcOffset,
 			NI_GRPH_INPUT_GAMMA_MODE(NI_INPUT_GAMMA_USE_LUT) |
 			NI_OVL_INPUT_GAMMA_MODE(NI_INPUT_GAMMA_USE_LUT));
@@ -625,10 +655,10 @@ display_dce45_crtc_load_lut(uint8 crtcID)
 	Write32(OUT, EVERGREEN_DC_LUT_WHITE_OFFSET_GREEN + regs->crtcOffset, 0xffff);
 	Write32(OUT, EVERGREEN_DC_LUT_WHITE_OFFSET_RED + regs->crtcOffset, 0xffff);
 
-	Write32(OUT, EVERGREEN_DC_LUT_RW_MODE, 0);
-	Write32(OUT, EVERGREEN_DC_LUT_WRITE_EN_MASK, 0x00000007);
+	Write32(OUT, EVERGREEN_DC_LUT_RW_MODE + regs->crtcOffset, 0);
+	Write32(OUT, EVERGREEN_DC_LUT_WRITE_EN_MASK + regs->crtcOffset, 0x00000007);
 
-	Write32(OUT, EVERGREEN_DC_LUT_RW_INDEX, 0);
+	Write32(OUT, EVERGREEN_DC_LUT_RW_INDEX + regs->crtcOffset, 0);
 	for (int i = 0; i < 256; i++) {
 		Write32(OUT, EVERGREEN_DC_LUT_30_COLOR + regs->crtcOffset,
 			(r[i] << 20) | (g[i] << 10) | (b[i] << 0));
