 headers/private/graphics/radeon_hd/vol_reg.h  | 10 +++++
 src/add-ons/accelerants/radeon_hd/display.cpp | 42 ++++++++++++++++---
 .../drivers/graphics/radeon_hd/driver.cpp     | 20 +++++----
 .../drivers/graphics/radeon_hd/radeon_hd.cpp  |  9 +++-
 5 files changed, 66 insertions(+), 19 deletions(-)

