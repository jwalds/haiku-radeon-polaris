+++ b/headers/private/graphics/radeon_hd/vol_reg.h
@@ -27,6 +27,16 @@
 #ifndef DCE_10_0_D_H
 #define DCE_10_0_D_H
 
+// DCE 10.x, 11.x CRTC register offsets (byte addresses)
+#define VOL_CRTC0_REGISTER_OFFSET		(0x6e70 - 0x6e70)
+#define VOL_CRTC1_REGISTER_OFFSET		(0x7670 - 0x6e70)
+#define VOL_CRTC2_REGISTER_OFFSET		(0x7e70 - 0x6e70)
+#define VOL_CRTC3_REGISTER_OFFSET		(0x10670 - 0x6e70)
+#define VOL_CRTC4_REGISTER_OFFSET		(0x10e70 - 0x6e70)
+#define VOL_CRTC5_REGISTER_OFFSET		(0x11670 - 0x6e70)
+
+#define VOL_LB_DESKTOP_HEIGHT			0x6b0c
+
 #define VOL_mmDC_GPIO_HPD_A                                                         0x488d
 
 #endif /* DCE_10_0_D_H */
diff --git a/src/add-ons/accelerants/radeon_hd/display.cpp b/src/add-ons/accelerants/radeon_hd/display.cpp
