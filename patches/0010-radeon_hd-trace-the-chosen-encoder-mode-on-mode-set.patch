diff --git a/src/add-ons/accelerants/radeon_hd/encoder.cpp b/src/add-ons/accelerants/radeon_hd/encoder.cpp
index 84f43db71a..463590f609 100644
--- a/src/add-ons/accelerants/radeon_hd/encoder.cpp
+++ b/src/add-ons/accelerants/radeon_hd/encoder.cpp
@@ -396,6 +396,12 @@ encoder_mode_set(uint8 crtcID)
 	// TODO: Should this be the adjusted pll or the original?
 	uint32 pixelClock = pll->pixelClock;
 
+	TRACE("%s: encoder mode %" B_PRIu32 ", EDID sections %" B_PRIu8
+		", CTA data blocks %" B_PRIu8 "\n", __func__,
+		display_get_encoder_mode(connectorIndex),
+		gDisplay[crtcID]->edidData.num_sections,
+		gDisplay[crtcID]->edidData.cta_block.num_data_blocks);
+
 	switch (gConnector[connectorIndex]->encoder.objectID) {
 		case ENCODER_OBJECT_ID_INTERNAL_DAC1:
 		case ENCODER_OBJECT_ID_INTERNAL_KLDSCP_DAC1:
