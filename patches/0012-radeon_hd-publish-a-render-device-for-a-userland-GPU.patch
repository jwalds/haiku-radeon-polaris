+++ b/src/add-ons/kernel/drivers/graphics/radeon_hd/driver.cpp
@@ -666,6 +666,8 @@ int32 api_version = B_CUR_DRIVER_API_VERSION;
 
 
 char* gDeviceNames[MAX_CARDS + 1];
+char* gRenderDeviceNames[MAX_CARDS + 1];
+static char* sPublishedNames[2 * MAX_CARDS + 1];
 radeon_info* gDeviceInfo[MAX_CARDS];
 pci_module_info* gPCI;
 mutex gLock;
@@ -704,7 +706,7 @@ extern "C" const char**
 publish_devices(void)
 {
 	TRACE("%s\n", __func__);
-	return (const char**)gDeviceNames;
+	return (const char**)sPublishedNames;
 }
 
 
@@ -769,9 +771,19 @@ init_driver(void)
 		if (gDeviceNames[found] == NULL)
 			break;
 
+		sprintf(name, "graphics/%s_%02x%02x%02x", RENDER_DEVICE_NAME,
+			info->bus, info->device, info->function);
+
+		gRenderDeviceNames[found] = strdup(name);
+		if (gRenderDeviceNames[found] == NULL) {
+			free(gDeviceNames[found]);
+			break;
+		}
+
 		gDeviceInfo[found] = (radeon_info*)malloc(sizeof(radeon_info));
 		if (gDeviceInfo[found] == NULL) {
 			free(gDeviceNames[found]);
+			free(gRenderDeviceNames[found]);
 			break;
 		}
 
@@ -796,6 +808,13 @@ init_driver(void)
 	}
 
 	gDeviceNames[found] = NULL;
+	gRenderDeviceNames[found] = NULL;
+
+	for (int32 index = 0; index < found; index++) {
+		sPublishedNames[2 * index] = gDeviceNames[index];
+		sPublishedNames[2 * index + 1] = gRenderDeviceNames[index];
+	}
+	sPublishedNames[2 * found] = NULL;
 
 	if (found == 0) {
 		mutex_destroy(&gLock);
@@ -820,6 +839,7 @@ uninit_driver(void)
 	char* name;
 	for (int32 index = 0; (name = gDeviceNames[index]) != NULL; index++) {
 		free(gDeviceInfo[index]);
+		free(gRenderDeviceNames[index]);
 		free(name);
 	}
 
@@ -837,6 +857,8 @@ find_device(const char* name)
 	for (index = 0; gDeviceNames[index] != NULL; index++) {
 		if (!strcmp(name, gDeviceNames[index]))
 			return &gDeviceHooks;
+		if (!strcmp(name, gRenderDeviceNames[index]))
+			return &gRenderDeviceHooks;
 	}
 
 	ERROR("%s: %s wasn't found!\n", __func__, name);
